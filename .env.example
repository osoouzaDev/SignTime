# Copie este arquivo para .env e preencha localmente. Nunca envie o .env ao GitHub.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres
DATABASE_SSLMODE=require
COOKIE_SECURE=false
SESSION_DURATION_HOURS=8

# No executável portátil, use somente a URL HTTPS pública do backend.
SIGNTIME_AUTH_API_URL=https://seu-servico.onrender.com
